{
  "name": "dsh-git-tree-gui",
  "version": "0.2.3",
  "description": "Git tree GUI for DeepSeek Harness: sub-repository discovery, WebStorm-style log/commit/stash panel, branch actions, whole-file editable diffs",
  "type": "module",
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "PATCH.md",
    "index.json"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "git-graph",
    "git-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IKUN798ProMax/dsh-git-tree-GUI.git"
  },
  "homepage": "https://github.com/IKUN798ProMax/dsh-git-tree-GUI",
  "bugs": {
    "url": "https://github.com/IKUN798ProMax/dsh-git-tree-GUI/issues"
  },
  "author": "peihongwei"
}
